# Endpoint que recebe o POST do formulário de contato (ex.: Formspree, Getform,
# uma função serverless própria). Deixe vazio para usar o fallback "mailto:".
VITE_CONTACT_ENDPOINT=

# "true" força a exibição dos cards de preenchimento (placeholders) no build de produção.
# Por padrão eles aparecem apenas em `npm run dev`.
VITE_SHOW_PLACEHOLDERS=
